# Actual secrets are generated on the host in /etc/chatwoot/chatwoot.env (0600).
SECRET_KEY_BASE=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=chatwoot
POSTGRES_DATABASE=chatwoot_production
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
FRONTEND_URL=https://chatwoot.mesa.tech
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=3
SIDEKIQ_CONCURRENCY=2
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
VIPS_BLOCK_UNTRUSTED=1
DISABLE_TELEMETRY=true
# Copy existing Plane SMTP configuration through the bootstrap helper.
MAILER_SENDER_EMAIL=
SMTP_DOMAIN=mesa.tech
SMTP_ADDRESS=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_SSL=true
SMTP_OPENSSL_VERIFY_MODE=peer
# Resend incoming MIME relay; independent from outgoing SMTP credentials.
RAILS_INBOUND_EMAIL_SERVICE=relay
RAILS_INBOUND_EMAIL_PASSWORD=
MAILER_INBOUND_EMAIL_DOMAIN=suporte.mesa.tech
SUPPORT_EMAIL=vendeuganhou@suporte.mesa.tech
SUPPORT_SMTP_PASSWORD=
